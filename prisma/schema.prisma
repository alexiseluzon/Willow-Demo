generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum TicketSource {
  MANUAL
  N8N
}

model Ticket {
  id        String       @id @default(cuid())
  title     String
  detail    String?
  status    TicketStatus @default(OPEN)
  source    TicketSource @default(MANUAL)
  category     TicketCategory?
  priority     TicketPriority?
  summary      String?
  triageStatus TriageStatus     @default(PENDING)
  embedding    Unsupported("vector(384)")?
  notes     Note[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([status])
  @@index([priority])
}

model Note {
  id        String   @id @default(cuid())
  body      String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId  String
  createdAt DateTime @default(now())

  @@index([ticketId])
}

enum TicketCategory {
  BUG
  BILLING
  FEATURE_REQUEST
  ACCOUNT
  OTHER
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TriageStatus {
  PENDING
  DONE
  FAILED
}